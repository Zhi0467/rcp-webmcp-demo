{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The RCP application window. Artifact preview windows intentionally do not match this capability.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*",
      "https://rcp-*.localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "allow-desktop-status",
    "allow-desktop-reconnect-backend",
    "allow-desktop-show-ready",
    "allow-desktop-list-team-connections",
    "allow-desktop-configure-server-operator-route",
    "allow-desktop-probe-server-operator",
    "allow-desktop-run-project-provision",
    "allow-desktop-open-project-provision-terminal",
    "allow-desktop-run-project-transfer",
    "allow-desktop-prepare-project-transfer",
    "allow-desktop-load-project-transfer",
    "allow-desktop-advance-project-transfer",
    "allow-desktop-run-incoming-project-provision",
    "allow-desktop-read-target-project-provisioning-options",
    "allow-desktop-export-project-transfer",
    "allow-desktop-select-project-transfer-export",
    "allow-desktop-open-project-transfer-terminal",
    "allow-desktop-finish-project-transfer",
    "allow-desktop-discard-project-transfer-export",
    "allow-desktop-remove-team-connection-metadata",
    "allow-desktop-remove-team-member-token",
    "allow-desktop-connect-team-tunnel",
    "allow-desktop-enroll-team-connection",
    "allow-desktop-add-existing-team-connection",
    "allow-desktop-establish-team-session",
    "allow-desktop-navigate-team",
    "allow-desktop-return-to-personal",
    "allow-choose-repository-folder",
    "allow-desktop-start-dictation",
    "allow-desktop-stop-dictation",
    "allow-open-artifact-preview",
    "allow-open-episode-report-preview",
    "allow-open-repository-file-preview",
    "allow-download-artifact",
    "allow-open-external",
    "allow-request-quit",
    "allow-check-for-update",
    "allow-apply-update"
  ]
}
